{
  "name": "@minpeter/pss-edit-format-bench",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "tsx --conditions=@minpeter/pss-source src/run.ts",
    "bench:agentic": "tsx --conditions=@minpeter/pss-source src/agentic-run.ts",
    "fixtures": "tsx --conditions=@minpeter/pss-source src/fixtures-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@minpeter/pss-coding-agent": "workspace:*",
    "@minpeter/pss-runtime": "workspace:*",
    "@oh-my-pi/hashline": "18.1.5",
    "ai": "7.0.143",
    "dotenv": "^17.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
